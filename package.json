{
  "name": "notebooklm-klon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm knip && pnpm audit:duplication && pnpm audit:magic",
    "depcruise": "depcruise --config config/dependency-cruiser.cjs apps packages",
    "depcruise:graph": "depcruise --config config/dependency-cruiser.cjs --output-type mermaid apps packages > architecture.mmd",
    "knip": "knip --include dependencies,unlisted,binaries,unresolved,files,cycles",
    "audit:duplication": "jscpd",
    "audit:magic": "node scripts/audit/audit-magic-strings.mjs",
    "test": "vitest run --project shared --project api --project hooks --project web",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:db": "vitest run --project db",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.3",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          ".claude/hooks/guard-*.mjs"
        ],
        "ignore": [
          "spikes/**"
        ]
      },
      "apps/web": {
        "ignoreDependencies": [
          "jsdom"
        ]
      }
    }
  },
  "jscpd": {
    "path": [
      "apps/api/src",
      "apps/web/src",
      "packages/shared/src"
    ],
    "ignore": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**"
    ],
    "threshold": 2,
    "reporters": [
      "console"
    ],
    "gitignore": true
  }
}
