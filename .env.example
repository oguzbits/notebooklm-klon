# Copy to .env.local and fill in. .env.local is git-ignored.
# The API refuses to start if a required value is missing or blank.

# development | test | production (default: development)
NODE_ENV=development

# Port of the API (default: 3000)
PORT=3000

# Google AI Studio key (required). Use a separate Google project for the live demo.
GEMINI_API_KEY=

# Model IDs (all required). They come from the model spike, see docs/SPIKE-ERGEBNISSE.md; never
# hardcode them in code. Chat, PDF parsing and embeddings each have their own.
AI_MODEL=
PARSE_MODEL=
# Optional. A second, larger model for PDFs that PARSE_MODEL refuses as recitation (finishReason
# RECITATION, seen with the scanned NIST paper). Unset: such a PDF fails.
PARSE_FALLBACK_MODEL=
EMBEDDING_MODEL=

# Auth (both required). BETTER_AUTH_SECRET signs the session cookies, at least 32 characters:
# `openssl rand -base64 32`. BETTER_AUTH_URL is the public origin of the app, for example
# http://localhost:5173 in development (the web dev server proxies /api to the API).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Folder of the built web app (optional). When set, the API serves it, so one process is enough:
# `pnpm build`, then WEB_DIST_DIR=apps/web/dist. Leave it out in development (Vite serves the app).
# WEB_DIST_DIR=apps/web/dist

# Account of the example notebook (`pnpm seed:demo`; password at least 8 characters). Guests of the
# live demo get a copy of its notebook, so SEED_DEMO_EMAIL must also be set where the app runs.
# Nobody needs to sign in as this account: the button "Beispiel ausprobieren" makes guests.
# SEED_DEMO_EMAIL=
# SEED_DEMO_PASSWORD=

# Postgres connection string (required). Use the DIRECT connection of the Neon project (no
# "-pooler" in the host): migrations and pg-boss need session features a pooler may not offer.
DATABASE_URL=

# Only for `pnpm test:db`. Optional: defaults to the local container from `pnpm db:up`.
# The database name must end with _test because the tests reset the whole schema.
# TEST_DATABASE_URL=postgresql://nlm:nlm@localhost:54329/nlm_test

# Optional. Key of the web search ("Im Web nach neuen Quellen suchen"), from tavily.com (free plan:
# 1000 credits a month, no card). Without it the search box is not shown. Search terms, not documents,
# are sent to Tavily.
# TAVILY_API_KEY=

# Optional. An S3-compatible object store for the cover images ("Notizbuch anpassen"): set all of
# S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY or none. Without them the upload is
# not offered. The bucket is created at start if it is missing. Locally `pnpm db:up` starts one
# (SeaweedFS, credentials in docker/s3.json): S3_ENDPOINT=http://localhost:8333
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
